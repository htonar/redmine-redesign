{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Redfine",
  "identifier": "com.htonar.redfine",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Redfine",
        "width": 1280,
        "height": 832,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFBQTgwNkRDQjkwMTU2OTgKUldTWVZnRzUzQWFvcWl1d3YyY09xcHFrV3NrOElKQytXWjk0SWNWNm1LaXJJSkF4bGk0SXZ5eWUK",
      "endpoints": [
        "https://github.com/htonar/redmine-redesign/releases/latest/download/latest.json"
      ]
    }
  }
}
