PORT=8787
ALLOWED_ORIGIN=http://localhost:5183
# Список разрешенных целевых хостов через запятую - без этого прокси отклоняет
# все. Включает Redmine-инстанс(ы) и, если нужен живой статус GitLab MR
# (issue #22, шаг 2), gitlab.com или self-hosted GitLab. GitHub сюда добавлять
# не нужно - у его REST API есть CORS из коробки, запросы идут напрямую из
# браузера без прокси.
ALLOWED_PROXY_HOSTS=redmine.example.com
